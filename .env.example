# MarketImmune environment configuration template.
# Copy to `.env` and fill in real values. `.env` is gitignored.

# ---------------------------------------------------------------------------
# Data root. Raw downloads go to <root>/bronze, parsed tables to silver/ and gold/.
# ---------------------------------------------------------------------------
MARKETIMMUNE_DATA=data

# ---------------------------------------------------------------------------
# Promoted markout model served by the Django API (paths from the repo root).
# ---------------------------------------------------------------------------
# MARKETIMMUNE_PROMOTED_MARKOUT_MODEL_PATH=data/models/<model>.cbm
# MARKETIMMUNE_PROMOTED_MARKOUT_CALIBRATOR_PATH=data/models/<model>.isotonic.json
# MARKETIMMUNE_PROMOTED_MARKOUT_REPORT_PATH=eval/markout_sol_10s/<report>.json
# MARKETIMMUNE_PROMOTED_MARKOUT_GOLD_ROOT=data/gold/hyperliquid/training/SOL
# MARKETIMMUNE_MARKOUT_DECISION_LIMIT=20
# MARKETIMMUNE_MARKOUT_DECISION_REFRESH_TTL_MS=30000
