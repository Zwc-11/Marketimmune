# Data never enters git: data/bronze (raw downloads), silver/, gold/, models/, logs/.
# Anchored so it does not match frontend/src/data/.
/data/
/_to_delete/
/staticfiles/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.venv-sim/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
build/
dist/
*.whl

# Rust
/target/

# Frontend
node_modules/
frontend/dist/
frontend/vite.config.ts.timestamp-*.mjs

# Local state and secrets (use .env.example as the template)
db.sqlite3
db.sqlite3-*
.env
.env.*
!.env.example

# Editor and agent caches
.tmp/
.codex/
.claude/*
!.claude/settings.json
.cursor/
.ipynb_checkpoints/

# Out-of-fold predictions written next to each eval/ report (large; rebuilt by the trainer)
*.oof.parquet
# The A1 ladder's per-day trainer reports (one per tested day, rung and model); the per-rung
# summary next to them keeps each day's seed, rows and leakage flag
/eval/a1/folds/
/eval/a1/*/folds/
