{
  "name": "marketimmune-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Exchange-style React + TypeScript terminal for MarketImmune: live SOL-PERP book, 10s maker-regret tape, and the CatBoost markout model.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:server": "npm run build && node scripts/copy-to-server.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "lightweight-charts": "5.2.1",
    "motion": "12.23.12",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "2.1.9"
  }
}
